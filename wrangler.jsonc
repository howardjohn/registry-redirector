{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "registry-redirect",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-02",
	"observability": {
		"enabled": true
	},
	"env": {
		"agentgateway": {
			"account_id": "0653eeaee9bffe11be6693c01ef6e885",
			"analytics_engine_datasets": [
				{
					"binding": "IMAGE_PULLS",
					"dataset": "image_pulls"
				}
			],
			"vars": {
				"TARGET_REGISTRIES": {
					"cr.agentgateway.dev": {
						"mappings": {
							"agentgateway": "ghcr.io/agentgateway/agentgateway",
							"controller": "ghcr.io/agentgateway/controller",
							"kgateway": "ghcr.io/kgateway-dev/kgateway",
							"charts/agentgateway": "ghcr.io/agentgateway/charts/agentgateway",
							"charts/agentgateway-crds": "ghcr.io/agentgateway/charts/agentgateway-crds",
							"charts/agentgateway-standalone": "ghcr.io/agentgateway/charts/agentgateway-standalone"
						},
						// agentgateway v2.x tags predate 1.0; see https://github.com/agentgateway/agentgateway/issues/3457
						"blockedTags": {
							// controller: not shipped yet, enable later
							// "ghcr.io/agentgateway/controller": {
							// 	"message": "agentgateway v2.x tags are retired (they predate 1.0); use 1.x. See https://github.com/agentgateway/agentgateway/issues/3457",
							// 	"tags": [
							// 		"v2.2.0",
							// 		"v2.2.0-amd64",
							// 		"v2.2.0-arm64",
							// 		"v2.2.0-beta.5",
							// 		"v2.2.0-beta.5-amd64",
							// 		"v2.2.0-beta.5-arm64",
							// 		"v2.2.0-beta.6",
							// 		"v2.2.0-beta.6-amd64",
							// 		"v2.2.0-beta.6-arm64",
							// 		"v2.2.0-main",
							// 		"v2.2.0-main-amd64",
							// 		"v2.2.0-main-arm64",
							// 		"v2.2.0-rc.1",
							// 		"v2.2.0-rc.1-amd64",
							// 		"v2.2.0-rc.1-arm64",
							// 		"v2.2.0-rc.2",
							// 		"v2.2.0-rc.2-amd64",
							// 		"v2.2.0-rc.2-arm64",
							// 		"v2.2.1",
							// 		"v2.2.1-amd64",
							// 		"v2.2.1-arm64",
							// 		"v2.3.0-beta.1",
							// 		"v2.3.0-beta.1-amd64",
							// 		"v2.3.0-beta.1-arm64",
							// 		"v2.3.0-main",
							// 		"v2.2.3"
							// 	]
							// },
							"ghcr.io/agentgateway/charts/agentgateway": {
								"message": "agentgateway v2.x tags are retired (they predate 1.0); use 1.x. See https://github.com/agentgateway/agentgateway/issues/3457",
								"tags": [
									"v2.2.0",
									"v2.2.0-beta.2",
									"v2.2.0-beta.3",
									"v2.2.0-beta.4",
									"v2.2.0-beta.5",
									"v2.2.0-beta.6",
									"v2.2.0-main",
									"v2.2.0-rc.1",
									"v2.2.0-rc.2",
									"v2.2.1",
									"2.2.1",
									"v2.3.0-main"
								]
							},
							"ghcr.io/agentgateway/charts/agentgateway-crds": {
								"message": "agentgateway v2.x tags are retired (they predate 1.0); use 1.x. See https://github.com/agentgateway/agentgateway/issues/3457",
								"tags": [
									"v2.2.0",
									"v2.2.0-beta.2",
									"v2.2.0-beta.3",
									"v2.2.0-beta.4",
									"v2.2.0-beta.5",
									"v2.2.0-beta.6",
									"v2.2.0-main",
									"v2.2.0-rc.1",
									"v2.2.0-rc.2",
									"v2.2.1",
									"2.2.1",
									"v2.3.0-main"
								]
							}
						}
					}
				}
			}
		},
		"kgateway": {
			"account_id": "0653eeaee9bffe11be6693c01ef6e885",
			"analytics_engine_datasets": [
				{
					"binding": "IMAGE_PULLS",
					"dataset": "image_pulls"
				}
			],
			"vars": {
				"TARGET_REGISTRIES": {
					"cr.kgateway.dev": {
						"mappings": {
							"kgateway-dev/kgateway": "ghcr.io/kgateway-dev/kgateway",
							"kgateway-dev/sds": "ghcr.io/kgateway-dev/sds",
							"kgateway-dev/envoy-wrapper": "ghcr.io/kgateway-dev/envoy-wrapper",
							"kgateway-dev/charts/kgateway": "ghcr.io/kgateway-dev/charts/kgateway",
							"kgateway-dev/charts/kgateway-crds": "ghcr.io/kgateway-dev/charts/kgateway-crds"
						}
					}
				}
			}
		},
		"istio": {
			"account_id": "1eb8152ceed73d3ee6f66c3557819d4c",
			"analytics_engine_datasets": [
				{
					"binding": "IMAGE_PULLS",
					"dataset": "image_pulls"
				}
			],
			"vars": {
				"TARGET_REGISTRIES": {
					"registry-redirect-istio.cncf-istio.workers.dev": {
						"mappings": {
							"testing": "gcr.io/istio-testing",
							"release": "index.docker.io/istio"
						}
					}
				}
			}
		},
		"test": {
			"analytics_engine_datasets": [
				{
					"binding": "IMAGE_PULLS",
					"dataset": "image_pulls"
				}
			],
			"vars": {
				"TARGET_REGISTRIES": {
					"cr.example.com": {
						"mappings": {
							"image1": "example.org/a/b",
							"image2": "alt.example.org/c",
							"image3/subimage": "alt.example.org/d/e"
						},
						"blockedTags": {
							"example.org/a/b": {
								"message": "v2 tags are retired",
								"tags": ["v2.0.0", "2.0.0"]
							}
						}
					}
				}
			}
		}
	}
}
